menu "CAT bridge (radio link)"

    config CAT_UART_NUM
        int "UART number used for CAT"
        range 1 2
        default 2
        help
            UART0 is reserved for the USB console / wired host link.

    config CAT_TX_PIN
        int "CAT TX GPIO (ESP32 -> radio)"
        default 32

    config CAT_RX_PIN
        int "CAT RX GPIO (radio -> ESP32)"
        default 34

    config CAT_BAUD_RATE
        int "CAT baud rate"
        default 9600

    choice CAT_FRAMING
        prompt "Framing of data received from the radio"
        default CAT_FRAMING_RAW
        help
            How the bytes coming from the radio are grouped before being
            forwarded to the host. It does not alter the bytes themselves.

        config CAT_FRAMING_RAW
            bool "Raw: group by idle gap (binary protocols, transparent)"
        config CAT_FRAMING_LINE
            bool "Text lines terminated by CR or LF"
        config CAT_FRAMING_TERMINATOR
            bool "Terminated by a specific byte (';' Kenwood/Elecraft/Yaesu, 0xFD Icom CI-V)"
    endchoice

    config CAT_TERMINATOR
        hex "Terminator byte"
        depends on CAT_FRAMING_TERMINATOR
        default 0x3B
        help
            0x3B is ';' (Kenwood, Elecraft, modern Yaesu). 0xFD is the Icom CI-V end byte.

    config CAT_IDLE_TIMEOUT_MS
        int "Idle gap that closes a raw frame (ms)"
        depends on CAT_FRAMING_RAW
        default 20

    config CAT_TX_INVERT
        bool "Invert CAT TX polarity"
        default y
        help
            The CAT transmit path is ESP32 TXD -> U10 optocoupler LED ->
            phototransistor -> Q4, and Q4 is saturated at rest because R27
            pulls its base to the isolated +5V. The result is that DE9 pin 8
            idles LOW, which a UART receiver reads as a permanent break.
            Inverting TXD in the peripheral puts the line back to idle HIGH.

            Keep this enabled for the stock board. Disable it only for a radio
            whose CAT input expects the inverted polarity, for instance a true
            RS-232 input where 0 V already reads as a mark.

    config CAT_RX_INVERT
        bool "Invert CAT RX polarity"
        default n
        help
            The receive path (D5, Q5 as a PNP, R28, U12) does not invert: a low
            at DE9 pin 3 produces a low at the GPIO. Validated on 2026-11-09 by
            injecting plain TTL text from a PL2303. Keep this disabled unless
            the radio drives the line inverted.

    config CAT_PTT_PIN
        int "PTT output GPIO"
        default 33

    config CAT_PTT_ACTIVE_LOW
        bool "PTT is active low (optocoupler LED to GND)"
        default y

    config CAT_COS_PIN
        int "COS / squelch input GPIO"
        default 39
        help
            GPIO39 (SENSOR_VN) is input-only and has no internal pull-up;
            the board provides an external one.

    config CAT_COS_ACTIVE_LOW
        bool "COS is active low"
        default y

endmenu
